# ============================================================
# Samsung PRISM – Unified Engineering Agent
# Environment configuration template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# LOCAL LLM (OLLAMA)
# ----------------------------------------------------------

# Base URL for the Ollama API endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Local model to use for inference.
# Options tested: qwen2.5:1.5b, phi3:mini, mistral:7b
OLLAMA_MODEL=qwen2.5:1.5b

# Request timeout in seconds for LLM calls
OLLAMA_TIMEOUT=120

# LLM temperature (0.0 = deterministic, 1.0 = creative)
OLLAMA_TEMPERATURE=0.1

# Maximum tokens in the LLM response (0 = model default)
OLLAMA_MAX_TOKENS=0

# ----------------------------------------------------------
# MCP SERVER CONFIGURATION
# ----------------------------------------------------------

# Path to the MCP server configuration JSON file
MCP_CONFIG_PATH=config/mcp_servers.json

# ----------------------------------------------------------
# BINARY ANALYSIS SECURITY
# ----------------------------------------------------------

# Comma-separated list of directories where binary analysis is permitted.
# Binaries outside these directories will be rejected.
# Example: /home/user/binaries,/opt/samples
BINARY_ALLOWED_DIRS=

# Path to the binary analysis audit log file
BINARY_AUDIT_LOG=memory/binary_audit.log

# ----------------------------------------------------------
# MEMORY CONFIGURATION
# ----------------------------------------------------------

# SQLite database path for engineering memory
MEMORY_DB_PATH=memory/engineering_memory.db

# Directory for curated Markdown memory files
MEMORY_MARKDOWN_DIR=memory/markdown_store

# ----------------------------------------------------------
# AGENT CONFIGURATION
# ----------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Session ID prefix (auto-generated if not set)
SESSION_PREFIX=session

